# Server
RYNCTL_PORT=8080
# Generate with: openssl rand -hex 32
RYNCTL_SECRET=replace-with-a-strong-random-secret
RYNCTL_LOG_LEVEL=INFO

# Security
# Initial admin password (only applied when the database is first created)
RYNCTL_ADMIN_PASSWORD=replace-with-a-strong-initial-admin-password
# Set the Secure flag on session cookies when serving over HTTPS
RYNCTL_SECURE_COOKIES=false
RYNCTL_SESSION_DAYS=7
RYNCTL_MAX_LOGIN_ATTEMPTS=5
RYNCTL_LOCKOUT_MINUTES=15
RYNCTL_RATE_LIMIT_RPM=120
# Restrict local browsing to comma-separated roots; empty permits all paths
RYNCTL_BROWSE_ROOTS=

# Stop jobs after N seconds (0 = disabled)
RYNCTL_JOB_TIMEOUT=0

# Prune job runs + logs older than N days (0 = keep forever)
RYNCTL_RUN_RETENTION_DAYS=0

# Webhook notifications (empty = disabled)
RYNCTL_WEBHOOK_URL=
RYNCTL_WEBHOOK_EVENTS=failure

# Prometheus metrics
RYNCTL_METRICS=true

# Data directory (fixed to /data by Docker Compose)
# RYNCTL_DATA_DIR=/data
